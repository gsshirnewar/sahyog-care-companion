# Copy this file to .env in this directory for local development.
# Synthetic-only settings; never put real patient data or production credentials here.
APP_ENV=local
SYNTHETIC_DATA_ONLY=true
SUPABASE_URL=http://host.docker.internal:54321
# Issuer must exactly match `iss` in a locally issued access token.
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWKS_URL=http://host.docker.internal:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ALGORITHMS=ES256,RS256
# Fill from `supabase status` after `supabase start`. Never use the service-role key here.
SUPABASE_ANON_KEY=replace-with-local-anon-key
# Local-only Redis credential; replace before sharing this environment.
REDIS_PASSWORD=local-only-change-this-password
